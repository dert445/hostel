# Reference only: set these in Vercel Environment Variables or your shell.
# Choose ONE hosted database. Do not set both URLs.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-token
# Or remove the two Turso settings and set:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
ADMINS=h1sec@iitdh.ac.in|replace-with-a-strong-password|H1;h2sec@iitdh.ac.in|replace-with-another-strong-password|H2
